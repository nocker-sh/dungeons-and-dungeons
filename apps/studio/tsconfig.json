{
  "extends": "../../tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".void"
  ],
  "compilerOptions": {
    "paths": {
      "void/routes": [
        "./.void/routes.d.ts"
      ],
      "@/client/*": [
        "../main/client/*"
      ],
      "@/pages/*": [
        "../main/pages/*"
      ],
      "@/development/*": [
        "./development/*"
      ],
      "@/*": [
        "../../*"
      ]
    }
  }
}
