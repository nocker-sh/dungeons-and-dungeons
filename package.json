{
  "name": "dungeons-and-dungeons-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd apps/main && portless",
    "build": "cd apps/main && vp build && cd ../.. && bun scripts/check-release.ts",
    "preview": "cd apps/main && portless --script preview",
    "test": "vp test run",
    "test:full": "DND_TEST_FULL=1 vp test run",
    "test:story": "vp test run conversation onboarding quest --maxWorkers=1",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "check:concept": "bun scripts/check-concept.ts",
    "images": "bun scripts/images.ts",
    "studio": "bun scripts/studio.ts",
    "e2e:save-message": "bun tests/e2e/save-message.ts",
    "e2e:studio": "PLAYWRIGHT_SOFTWARE=1 bun tests/e2e/studio.ts",
    "e2e:conversations": "bun tests/e2e/conversations.ts",
    "e2e:layouts": "bun tests/e2e/layouts.ts",
    "e2e:timing": "bun tests/e2e/timing.ts",
    "e2e:animation": "bun tests/e2e/animation.ts",
    "deploy": "vp run build && cd apps/main && void deploy",
    "e2e:flows": "bun tests/e2e/flows.ts",
    "e2e:visual:base": "bun tests/e2e/visual.ts base",
    "e2e:visual": "bun tests/e2e/visual.ts check",
    "prepare": "cd apps/main && vp exec void prepare && cd ../studio && vp exec void prepare",
    "check:source": "bun scripts/check-source.ts",
    "cli": "bun builder/cli.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "dev:studio": "cd apps/studio && vp build --mode studio && portless --script preview",
    "dev:studio:watch": "cd apps/studio && portless",
    "build:dev": "vp run build:studio",
    "build:studio": "cd apps/studio && vp build --mode studio"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@void/react": "catalog:",
    "jsdom": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "pngjs": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
